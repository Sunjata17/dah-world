<div class="peters-container">
  <svg viewBox="0 0 1000 500" xmlns="http://www.w3.org/2000/svg" class="peters-map" aria-label="Peters Equal-Area World Map">
    <rect width="1000" height="500" fill="#0a1628" rx="4"/>
    <g stroke="#1a2a40" stroke-width="0.5" fill="none">
      <line x1="83.3" y1="0" x2="83.3" y2="500"/>
      <line x1="166.6" y1="0" x2="166.6" y2="500"/>
      <line x1="250" y1="0" x2="250" y2="500"/>
      <line x1="333.3" y1="0" x2="333.3" y2="500"/>
      <line x1="416.6" y1="0" x2="416.6" y2="500"/>
      <line x1="500" y1="0" x2="500" y2="500"/>
      <line x1="583.3" y1="0" x2="583.3" y2="500"/>
      <line x1="666.6" y1="0" x2="666.6" y2="500"/>
      <line x1="750" y1="0" x2="750" y2="500"/>
      <line x1="833.3" y1="0" x2="833.3" y2="500"/>
      <line x1="916.6" y1="0" x2="916.6" y2="500"/>
      <line x1="0" y1="250" x2="1000" y2="250" stroke="#2a3a50" stroke-width="1"/>
      <line x1="0" y1="125" x2="1000" y2="125"/>
      <line x1="0" y1="375" x2="1000" y2="375"/>
      <line x1="0" y1="33" x2="1000" y2="33"/>
      <line x1="0" y1="467" x2="1000" y2="467"/>
      <line x1="0" y1="150" x2="1000" y2="150" stroke="#2a3a50" stroke-width="0.3" stroke-dasharray="4,4"/>
      <line x1="0" y1="350" x2="1000" y2="350" stroke="#2a3a50" stroke-width="0.3" stroke-dasharray="4,4"/>
    </g>
    <path d="M480,180 L510,175 L530,185 L545,210 L548,240 L545,275 L535,310 L520,340 L505,360 L490,365 L475,355 L462,330 L455,300 L452,270 L455,240 L460,210 Z" fill="#2d4a2d" stroke="#3a6a3a" stroke-width="1"/>
    <path d="M460,75 L490,70 L510,75 L525,85 L520,100 L505,110 L490,115 L475,108 L462,95 Z" fill="#2a3d52" stroke="#3a5a72" stroke-width="1"/>
    <path d="M520,75 L620,65 L700,70 L750,80 L760,100 L740,125 L700,140 L650,145 L600,140 L555,130 L535,115 L525,100 Z" fill="#2a3d52" stroke="#3a5a72" stroke-width="1"/>
    <path d="M130,80 L200,75 L240,85 L255,105 L250,135 L235,160 L215,180 L195,185 L170,175 L145,155 L125,130 L115,105 Z" fill="#3d3a28" stroke="#6a6040" stroke-width="1"/>
    <path d="M210,215 L250,208 L275,220 L285,255 L282,295 L270,335 L248,368 L225,378 L205,370 L190,345 L182,310 L185,270 L190,240 Z" fill="#3d3a28" stroke="#6a6040" stroke-width="1"/>
    <path d="M700,295 L750,285 L790,295 L810,320 L805,350 L780,368 L748,372 L718,360 L700,335 L695,310 Z" fill="#4a3d28" stroke="#7a6040" stroke-width="1"/>
    <path d="M220,38 L250,32 L275,38 L280,55 L265,68 L240,72 L218,62 Z" fill="#2a3d52" stroke="#3a5a72" stroke-width="1"/>
    <g font-family="serif" fill="#c9a84c" font-size="10" opacity="0.7" text-anchor="middle">
      <text x="500" y="285">AFRICA</text>
      <text x="240" y="305">S. AMERICA</text>
      <text x="185" y="130">N. AMERICA</text>
      <text x="620" y="108">ASIA</text>
      <text x="752" y="335">AUSTRALIA</text>
    </g>
    <text x="12" y="247" font-family="serif" font-size="8" fill="#c9a84c" opacity="0.4">0°</text>
    <text x="12" y="122" font-family="serif" font-size="8" fill="#c9a84c" opacity="0.4">30°N</text>
    <text x="12" y="372" font-family="serif" font-size="8" fill="#c9a84c" opacity="0.4">30°S</text>
  </svg>
  <p class="projection-note">Unlike Mercator, the Peters projection preserves <em>area</em> — nations appear in true proportion to their actual landmass.</p>
</div>

<style>
  .peters-container { width: 100%; }
  .peters-map { width: 100%; height: auto; border-radius: 4px; border: 1px solid #2a2018; }
  .projection-note { margin-top: 1rem; text-align: center; font-size: 0.85rem; font-style: italic; opacity: 0.5; }
</style>
