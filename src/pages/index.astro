<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>DAH World — The World's Authority on African History</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Playfair+Display:wght@700;900&family=Source+Serif+4:wght@300;400;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0a0a06;color:#f0ebe0;font-family:'Source Serif 4',serif;min-height:100vh;overflow-x:hidden}

.top-bar{background:#B8860B;padding:6px 24px;display:flex;justify-content:space-between;align-items:center;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.08em;color:#0a0a06;font-weight:700}

nav{background:#0a0a06;border-bottom:1px solid #B8860B33;padding:0 24px;display:flex;align-items:center;height:64px;gap:0}
.nav-logo{font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:#f0ebe0;letter-spacing:-0.02em;margin-right:24px;flex-shrink:0;text-decoration:none}
.nav-logo span{color:#B8860B}
.nav-links{display:flex;gap:0;flex:1;list-style:none;flex-wrap:nowrap;overflow-x:auto}
.nav-links li a{display:block;padding:8px 11px;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:0.06em;color:#a09880;text-decoration:none;text-transform:uppercase;transition:color 0.2s;border-bottom:2px solid transparent;white-space:nowrap}
.nav-links li a:hover,.nav-links li a.active{color:#B8860B;border-bottom-color:#B8860B}
.nav-cta{background:#B8860B;color:#0a0a06 !important;padding:8px 16px !important;font-weight:700 !important;border-bottom:none !important;border-radius:2px}
.nav-cta:hover{background:#D4A020 !important}

.hero{position:relative;min-height:480px;background:linear-gradient(135deg,#1a0a00 0%,#0a0a06 40%,#0d1a0a 100%);display:flex;align-items:flex-end;padding:40px 24px;overflow:hidden}
.hero-bg{position:absolute;top:0;left:0;right:0;bottom:0;opacity:0.06;display:flex;align-items:center;justify-content:flex-end;padding-right:40px}
.hero-badge{position:absolute;top:24px;right:24px;background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.1em;padding:6px 12px;text-transform:uppercase}
.hero-eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.15em;color:#B8860B;text-transform:uppercase;margin-bottom:12px}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(2.5rem,5vw,3.5rem);font-weight:900;line-height:1.05;color:#f0ebe0;margin-bottom:16px}
.hero-title span{color:#B8860B}
.hero-sub{font-size:16px;font-weight:300;color:#a09880;line-height:1.6;max-width:480px;margin-bottom:24px}
.hero-content{position:relative;z-index:2;max-width:600px}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap}
.btn-gold{background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.1em;padding:12px 24px;text-decoration:none;text-transform:uppercase;display:inline-block}
.btn-gold:hover{background:#D4A020}
.btn-outline{border:1px solid #B8860B44;color:#B8860B;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.1em;padding:12px 24px;text-decoration:none;text-transform:uppercase;display:inline-block}
.btn-outline:hover{border-color:#B8860B;background:#B8860B11}

.ticker-wrap{background:#0f0e08;border-top:1px solid #B8860B22;border-bottom:1px solid #B8860B22;padding:10px 0;overflow:hidden;white-space:nowrap}
.ticker{display:inline-block;animation:ticker 40s linear infinite;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:0.12em;color:#B8860B}
.ticker span{margin:0 2rem;opacity:0.7}
.ticker span strong{opacity:1;color:#f0ebe0}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

.section{padding:40px 24px}
.sec-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:0.2em;color:#B8860B;text-transform:uppercase;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.sec-label::after{content:'';flex:1;height:1px;background:#B8860B44}

.continent-bar{display:flex;gap:4px;padding:0 24px 0;flex-wrap:wrap;margin-bottom:0}
.region-btn{background:#0f0e08;border:1px solid #2a2010;color:#a09880;font-family:'Space Mono',monospace;font-size:9px;font-weight:700;letter-spacing:0.1em;padding:6px 14px;cursor:pointer;text-transform:uppercase;transition:all 0.2s}
.region-btn:hover,.region-btn.active{background:#B8860B;color:#0a0a06;border-color:#B8860B}

.featured-grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:auto auto;gap:1px;background:#B8860B22;border:1px solid #B8860B22}
.story-card{background:#0f0f09;padding:20px;position:relative;cursor:pointer;transition:background 0.2s}
.story-card:hover{background:#141408}
.story-card-img{width:100%;height:160px;background:#1a1408;margin-bottom:14px;overflow:hidden;display:flex;align-items:center;justify-content:center}
.hero-card .story-card-img{height:220px}
.country-pill{font-family:'Space Mono',monospace;font-size:8px;font-weight:700;letter-spacing:0.12em;color:#B8860B;text-transform:uppercase;margin-bottom:8px}
.story-tag{display:inline-block;font-family:'Space Mono',monospace;font-size:8px;font-weight:700;letter-spacing:0.1em;padding:2px 8px;margin-bottom:10px;text-transform:uppercase}
.tag-dna{background:#1a2a0a;color:#8aaa5a}
.tag-stem{background:#0a1a2a;color:#5a9aba}
.tag-art{background:#1a0a2a;color:#9a6aba}
.tag-news{background:#2a0a0a;color:#ba6a5a}
.tag-history{background:#2a1a0a;color:#B8860B}
.story-headline{font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:#f0ebe0;line-height:1.4;margin-bottom:10px}
.hero-card .story-headline{font-size:20px}
.story-meta{font-family:'Space Mono',monospace;font-size:9px;color:#4a4030;letter-spacing:0.08em}

.stats-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#B8860B22;border:1px solid #B8860B22;margin:0 24px 40px}
.stat-cell{background:#0f0e08;padding:24px;text-align:center}
.stat-n{font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;color:#B8860B;line-height:1}
.stat-l{font-family:'Space Mono',monospace;font-size:9px;color:#6a5a40;letter-spacing:0.12em;text-transform:uppercase;margin-top:6px}

.offers-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#B8860B22;border:1px solid #B8860B22}
.offer-card{background:#0f0e08;padding:28px 24px;position:relative}
.offer-number{font-family:'Playfair Display',serif;font-size:3rem;font-weight:900;color:#B8860B22;line-height:1;margin-bottom:8px}
.offer-tag{font-family:'Space Mono',monospace;font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;background:#2a1a0a;color:#B8860B;display:inline-block;padding:3px 10px;margin-bottom:12px}
.offer-title{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:#f0ebe0;margin-bottom:10px;line-height:1.3}
.offer-desc{font-size:13px;color:#8a7a60;line-height:1.7;margin-bottom:16px}
.offer-price{font-family:'Space Mono',monospace;font-size:9px;color:#B8860B;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:12px}
.offer-cta{display:inline-block;background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.1em;padding:10px 20px;text-decoration:none;text-transform:uppercase}
.offer-cta:hover{background:#D4A020}
.offer-cta.outline{background:transparent;border:1px solid #B8860B;color:#B8860B}
.offer-cta.outline:hover{background:#B8860B;color:#0a0a06}
.offer-vip{border-top:3px solid #ffb347}

footer{background:#0f0e08;border-top:1px solid #B8860B22;padding:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.footer-logo{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:900;color:#f0ebe0}
.footer-logo span{color:#B8860B}
.footer-tagline{font-family:'Space Mono',monospace;font-size:9px;color:#4a4030;letter-spacing:0.12em;text-transform:uppercase}
</style>
</head>
