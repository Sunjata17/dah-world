<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>DAH World — The World's Authority on African History</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Playfair+Display:wght@700;900&family=Source+Serif+4:wght@300;400;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;overflow-x:hidden}
body{background:#0a0a06;color:#f0ebe0;font-family:'Source Serif 4',serif;min-height:100vh}
.page-wrap{max-width:1440px;margin:0 auto;background:#0a0a06}

.top-bar{background:#B8860B;padding:8px 24px;display:flex;justify-content:space-between;align-items:center;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:0.08em;color:#0a0a06;font-weight:700}

nav{background:#0a0a06;border-bottom:1px solid #B8860B33;padding:0 24px;display:flex;align-items:center;min-height:72px;gap:0}
.nav-logo{font-family:'Playfair Display',serif;font-size:24px;font-weight:900;color:#f0ebe0;letter-spacing:-0.02em;margin-right:24px;flex-shrink:0;text-decoration:none}
.nav-logo span{color:#B8860B}
.nav-links{display:flex;gap:0;flex:1;list-style:none;flex-wrap:nowrap;overflow-x:auto}
.nav-links li a{display:block;padding:10px 12px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.06em;color:#a09880;text-decoration:none;text-transform:uppercase;transition:color 0.2s;border-bottom:3px solid transparent;white-space:nowrap}
.nav-links li a:hover,.nav-links li a.active{color:#B8860B;border-bottom-color:#B8860B}
.nav-cta{background:#B8860B;color:#0a0a06 !important;padding:10px 18px !important;font-weight:700 !important;border-bottom:none !important;border-radius:2px;font-size:12px !important}
.nav-cta:hover{background:#D4A020 !important}

.hero{position:relative;min-height:520px;background:linear-gradient(135deg,#1a0a00 0%,#0a0a06 40%,#0d1a0a 100%);display:flex;align-items:flex-end;padding:48px 32px;overflow:hidden}
.hero-bg{position:absolute;top:0;left:0;right:0;bottom:0;opacity:0.06;display:flex;align-items:center;justify-content:flex-end;padding-right:40px}
.hero-badge{position:absolute;top:24px;right:24px;background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.1em;padding:8px 14px;text-transform:uppercase}
.hero-eyebrow{font-family:'Space Mono',monospace;font-size:12px;letter-spacing:0.15em;color:#B8860B;text-transform:uppercase;margin-bottom:14px}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(2.8rem,5vw,4rem);font-weight:900;line-height:1.05;color:#f0ebe0;margin-bottom:18px}
.hero-title span{color:#B8860B}
.hero-sub{font-size:17px;font-weight:300;color:#a09880;line-height:1.7;max-width:500px;margin-bottom:28px}
.hero-content{position:relative;z-index:2;max-width:620px}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap}
.btn-gold{background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:12px;font-weight:700;letter-spacing:0.1em;padding:14px 28px;text-decoration:none;text-transform:uppercase;display:inline-block}
.btn-gold:hover{background:#D4A020}
.btn-outline{border:1px solid #B8860B66;color:#B8860B;font-family:'Space Mono',monospace;font-size:12px;font-weight:700;letter-spacing:0.1em;padding:14px 28px;text-decoration:none;text-transform:uppercase;display:inline-block}
.btn-outline:hover{border-color:#B8860B;background:#B8860B11}

.ticker-wrap{background:#0f0e08;border-top:1px solid #B8860B22;border-bottom:1px solid #B8860B22;padding:12px 0;overflow:hidden;white-space:nowrap}
.ticker{display:inline-block;animation:ticker 40s linear infinite;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.12em;color:#B8860B}
.ticker span{margin:0 2rem;opacity:0.7}
.ticker span strong{opacity:1;color:#f0ebe0}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

.region-bar{display:flex;gap:6px;padding:20px 24px;flex-wrap:wrap}
.region-btn{background:#0f0e08;border:1px solid #2a2010;color:#a09880;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.1em;padding:8px 16px;cursor:pointer;text-transform:uppercase;transition:all 0.2s}
.region-btn:hover,.region-btn.active{background:#B8860B;color:#0a0a06;border-color:#B8860B}

.map-layout{display:grid;grid-template-columns:1fr 300px;gap:1px;background:#B8860B22;border:1px solid #B8860B22;margin:0 24px 32px}
#hmap-wrap{position:relative;background:#0d2035;overflow:hidden;height:580px}
#hmap-svg{width:100%;height:100%;display:block;cursor:grab}
#hmap-svg:active{cursor:grabbing}
#hmap-card{position:absolute;pointer-events:none;display:none;z-index:30;width:230px}
.hmc-inner{background:#0f0e08;border:2px solid #B8860B;padding:14px 16px}
.hmc-badge{font-family:'Space Mono',monospace;font-size:8px;font-weight:700;letter-spacing:0.18em;color:#B8860B;text-transform:uppercase;margin-bottom:8px}
#hmc-flag{width:48px;height:30px;object-fit:cover;border:1px solid #3a2e18;margin-bottom:6px;display:block}
#hmc-name{font-family:'Playfair Display',serif;font-size:17px;font-weight:900;color:#fff;margin-bottom:2px}
#hmc-region{font-family:'Space Mono',monospace;font-size:9px;color:#B8860B;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:6px}
.hmc-row{display:flex;justify-content:space-between;border-top:1px solid #2a1e0e;padding:4px 0;font-size:10px;font-family:'Space Mono',monospace}
.hmc-key{color:#B8860B;font-weight:700}
.hmc-val{color:#fff;font-weight:700}
#hmc-fact{font-size:10px;color:#f0ebe0;line-height:1.5;margin-top:8px;border-top:1px solid #2a1e0e;padding-top:8px}
.hmc-cta{font-family:'Space Mono',monospace;font-size:8px;color:#B8860B;letter-spacing:0.12em;text-transform:uppercase;margin-top:8px;text-align:right}
.map-sidebar{background:#0f0e08;padding:20px;display:flex;flex-direction:column;gap:12px;overflow-y:auto}
.sidebar-label{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:0.2em;color:#B8860B;text-transform:uppercase;border-bottom:1px solid #B8860B22;padding-bottom:8px}
.sidebar-link{display:block;padding:10px;border:1px solid #2a2010;text-decoration:none;transition:border-color 0.2s}
.sidebar-link:hover{border-color:#B8860B}
.sidebar-region{font-family:'Space Mono',monospace;font-size:8px;color:#B8860B;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:3px}
.sidebar-name{font-family:'Playfair Display',serif;font-size:14px;font-weight:700;color:#f0ebe0}
.sidebar-fact{font-size:11px;color:#6a5a40;margin-top:2px}
.sidebar-all{display:block;text-align:center;background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;padding:12px;text-decoration:none;margin-top:auto}
.sidebar-all:hover{background:#D4A020}
.map-zoom{position:absolute;bottom:10px;right:10px;display:flex;flex-direction:column;gap:4px;z-index:20}
.mzb{background:#0a0a06cc;border:1px solid #B8860B88;color:#B8860B;font-family:'Space Mono',monospace;font-size:16px;font-weight:700;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.mzb:hover{background:#B8860B;color:#0a0a06}

.section{padding:40px 24px}
.sec-label{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#B8860B;text-transform:uppercase;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.sec-label::after{content:'';flex:1;height:1px;background:#B8860B44}

.featured-grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:auto auto;gap:1px;background:#B8860B22;border:1px solid #B8860B22}
.story-card{background:#0f0f09;padding:20px;position:relative;cursor:pointer;transition:background 0.2s}
.story-card:hover{background:#141408}
.story-card-img{width:100%;height:160px;background:#1a1408;margin-bottom:14px;overflow:hidden}
.hero-card .story-card-img{height:220px}
.country-pill{font-family:'Space Mono',monospace;font-size:9px;font-weight:700;letter-spacing:0.12em;color:#B8860B;text-transform:uppercase;margin-bottom:8px}
.story-tag{display:inline-block;font-family:'Space Mono',monospace;font-size:9px;font-weight:700;letter-spacing:0.1em;padding:3px 10px;margin-bottom:10px;text-transform:uppercase}
.tag-dna{background:#1a2a0a;color:#8aaa5a}
.tag-stem{background:#0a1a2a;color:#5a9aba}
.tag-art{background:#1a0a2a;color:#9a6aba}
.tag-news{background:#2a0a0a;color:#ba6a5a}
.tag-history{background:#2a1a0a;color:#B8860B}
.story-headline{font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:#f0ebe0;line-height:1.4;margin-bottom:10px}
.hero-card .story-headline{font-size:20px}
.story-meta{font-family:'Space Mono',monospace;font-size:10px;color:#4a4030;letter-spacing:0.08em}

.stats-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#B8860B22;border:1px solid #B8860B22;margin:0 24px 40px}
.stat-cell{background:#0f0e08;padding:28px;text-align:center}
.stat-n{font-family:'Playfair Display',serif;font-size:3rem;font-weight:900;color:#B8860B;line-height:1}
.stat-l{font-family:'Space Mono',monospace;font-size:10px;color:#6a5a40;letter-spacing:0.12em;text-transform:uppercase;margin-top:8px}

.offers-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#B8860B22;border:1px solid #B8860B22}
.offer-card{background:#0f0e08;padding:28px 24px}
.offer-number{font-family:'Playfair Display',serif;font-size:3rem;font-weight:900;color:#B8860B22;line-height:1;margin-bottom:8px}
.offer-tag{font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;background:#2a1a0a;color:#B8860B;display:inline-block;padding:4px 12px;margin-bottom:14px}
.offer-title{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:900;color:#f0ebe0;margin-bottom:12px;line-height:1.3}
.offer-desc{font-size:14px;color:#8a7a60;line-height:1.7;margin-bottom:18px}
.offer-price{font-family:'Space Mono',monospace;font-size:10px;color:#B8860B;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:14px}
.offer-cta{display:inline-block;background:#B8860B;color:#0a0a06;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.1em;padding:12px 22px;text-decoration:none;text-transform:uppercase}
.offer-cta:hover{background:#D4A020}
.offer-cta.outline{background:transparent;border:1px solid #B8860B;color:#B8860B}
.offer-cta.outline:hover{background:#B8860B;color:#0a0a06}
.offer-vip{border-top:3px solid #ffb347}

footer{background:#0f0e08;border-top:1px solid #B8860B22;padding:28px 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
.footer-logo{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:#f0ebe0}
.footer-logo span{color:#B8860B}
.footer-tagline{font-family:'Space Mono',monospace;font-size:10px;color:#4a4030;letter-spacing:0.12em;text-transform:uppercase}
</style>
</head>
