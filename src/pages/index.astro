const mw=document.getElementById("hmap-wrap");
const hcard=document.getElementById("hmap-card");
const W=700,H=900;
const proj=d3.geoEqualEarth().center([25,0]).scale(820).translate([W/2,H/2+80]);
const pg=d3.geoPath().projection(proj);
const svg=d3.select("#hmap-svg").attr("viewBox",`0 0 ${W} ${H}`);
svg.append("rect").attr("width",W).attr("height",H).attr("fill","#0d2035");
const g=svg.append("g");
function pos(e){const r=mw.getBoundingClientRect();let x=e.clientX-r.left+14,y=e.clientY-r.top-20;if(x+240>r.width-8)x=e.clientX-r.left-244;if(y<4)y=4;if(y+280>r.height-4)y=r.height-284;hcard.style.left=x+"px";hcard.style.top=y+"px";}
function show(e,i){document.getElementById("hmc-flag").src="https://flagcdn.com/w80/"+i.flag+".png";document.getElementById("hmc-name").textContent=i.name;document.getElementById("hmc-region").textContent=i.region+" Africa";document.getElementById("hmc-cap").textContent=i.cap;document.getElementById("hmc-pop").textContent=i.pop;document.getElementById("hmc-fact").textContent=i.fact;hcard.style.display="block";pos(e);}
const zoom=d3.zoom().scaleExtent([0.8,8]).on("zoom",ev=>g.attr("transform",ev.transform));
svg.call(zoom);
document.getElementById("mzin").onclick=()=>svg.transition().duration(300).call(zoom.scaleBy,1.5);
document.getElementById("mzout").onclick=()=>svg.transition().duration(300).call(zoom.scaleBy,0.67);
d3.json("/countries-110m.json").then(world=>{
  const all=topojson.feature(world,world.objects.countries);
  const africa=all.features.filter(f=>CD[String(parseInt(f.id))]);
  g.selectAll("path").data(africa).join("path").attr("d",pg)
  .attr("fill",d=>{const i=CD[String(parseInt(d.id))];return i?i.color:"#4a6a4a";})
  .style("stroke","#0a0a06").style("stroke-width","1.2").style("cursor","pointer")
  .on("mouseover",function(e,d){const i=CD[String(parseInt(d.id))];if(i){d3.select(this).attr("fill","#F5D080");show(e,i);}})
  .on("mousemove",function(e){pos(e);})
  .on("mouseout",function(e,d){const i=CD[String(parseInt(d.id))];if(i)d3.select(this).attr("fill",i.color);hcard.style.display="none";})
  .on("click",function(e,d){const i=CD[String(parseInt(d.id))];if(i)window.location.href="/nations/"+i.slug;});
  africa.forEach(f=>{
    const info=CD[String(parseInt(f.id))];if(!info)return;
    const b=pg.bounds(f);const w=b[1][0]-b[0][0],h=b[1][1]-b[0][1];
    if(w<14||h<10)return;
    const c=pg.centroid(f);if(isNaN(c[0])||isNaN(c[1]))return;
    let name=info.name;if(w<22&&name.length>6)return;
    if(w<50&&name.length>20)name=name.split(" ").map(p=>p[0]+".").join("");
    const fs=Math.max(6.5,Math.min(w/(name.length*0.7),h/2.8,11));
    const tw=name.length*fs*0.63+8,th=fs+6;
    g.append("rect").attr("x",c[0]-tw/2).attr("y",c[1]-th/2).attr("width",tw).attr("height",th).attr("rx",2).attr("fill","#0a0a06").attr("opacity",0.85).attr("pointer-events","none");
    g.append("text").attr("x",c[0]).attr("y",c[1]).attr("text-anchor","middle").attr("dominant-baseline","middle").attr("font-family","Space Mono,monospace").attr("font-weight","700").attr("font-size",fs).attr("fill","#ffffff").attr("pointer-events","none").text(name);
  });
});
