<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0a0a06;color:#f0ebe0;font-family:'Source Serif 4',serif;min-height:100vh}
header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 2rem;border-bottom:1px solid #3a2e18}
.logo{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:#f0ebe0;text-decoration:none}
.logo span{color:#C4873A}
nav a{color:#f0ebe0;text-decoration:none;margin-left:2rem;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.5;transition:opacity 0.2s}
nav a:hover,nav a.active{opacity:1;color:#C4873A}
.hero{text-align:center;padding:3rem 2rem 2rem}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,3rem);font-weight:900;color:#f0ebe0;margin-bottom:0.5rem}
.hero h1 span{color:#C4873A}
.hero p{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.5;margin-top:0.5rem}
.sec-label{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:0.2em;color:#C4873A;text-transform:uppercase;display:flex;align-items:center;gap:8px;margin-bottom:14px}
.sec-label::after{content:'';flex:1;height:1px;background:#C4873A33}
#wrap{padding:0 2rem 2rem}
#header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
#legend{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.leg{display:flex;align-items:center;gap:5px;font-size:9px;color:#9a8a70;letter-spacing:0.06em;font-family:'Space Mono',monospace}
.ls{width:10px;height:10px;border-radius:2px;border:1px solid rgba(255,255,255,0.2)}
#map-wrap{position:relative;width:100%;background:#0d2035;border:2px solid #1a3a52;overflow:hidden;border-radius:4px}
#map-svg{width:100%;display:block;cursor:grab}
#map-svg:active{cursor:grabbing}
.cp{stroke:#0a0a06;stroke-width:1.2;stroke-opacity:1;cursor:pointer;transition:filter 0.15s}
.cp:hover{stroke:#F5D080;stroke-width:2.5;filter:brightness(1.4)}
#hcard{position:absolute;pointer-events:none;display:none;z-index:30;width:260px}
#hci{background:#0f0e08;border:2px solid #C4873A;border-radius:4px;padding:16px 18px 14px}
#hc-badge{font-family:'Space Mono',monospace;font-size:8px;font-weight:700;letter-spacing:0.18em;color:#C4873A;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px}
#hc-badge::after{content:'';flex:1;height:1px;background:#C4873A44}
#hc-flag{font-size:40px;line-height:1;margin-bottom:8px}
#hc-name{font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:#ffffff;line-height:1.1;margin-bottom:2px}
#hc-region{font-family:'Space Mono',monospace;font-size:9px;color:#E8A84A;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:10px}
.hcr{display:flex;justify-content:space-between;border-top:1px solid #2a1e0e;padding:5px 0;font-size:10px}
.hcl{font-family:'Space Mono',monospace;color:#C4873A;letter-spacing:0.05em;font-weight:700}
.hcv{font-family:'Space Mono',monospace;color:#ffffff;font-weight:700;text-align:right}
#hc-fact{font-size:11px;color:#f0ebe0;line-height:1.6;margin-top:10px;border-top:1px solid #2a1e0e;padding-top:10px;font-family:'Source Serif 4',serif}
#hc-cta{font-family:'Space Mono',monospace;font-size:8px;color:#C4873A;letter-spacing:0.14em;text-transform:uppercase;margin-top:10px;text-align:right;opacity:0.8}
#zc{position:absolute;bottom:10px;right:10px;display:flex;flex-direction:column;gap:4px;z-index:20}
.zb{background:#0a0a06cc;border:1px solid #C4873A88;color:#C4873A;font-family:'Space Mono',monospace;font-size:16px;font-weight:700;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:3px}
.zb:hover{background:#C4873A;color:#0a0a06}
#zh{position:absolute;bottom:10px;left:10px;font-family:'Space Mono',monospace;font-size:9px;color:#4a6070;letter-spacing:0.1em;z-index:20}
</style>
</head>
