const mapWrap=document.getElementById("map-wrap");
const hcard=document.getElementById("hcard");
mapWrap.style.height="900px";
const W=700,H=900;
const proj=d3.geoEqualEarth().center([25,1]).scale(600).translate([W/2,H/2+40]);
const pathGen=d3.geoPath().projection(proj);
const svg=d3.select("#map-svg").attr("viewBox",`0 0 ${W} ${H}`);
svg.append("rect").attr("width",W).attr("height",H).attr("fill","#0d2035");
const g=svg.append("g");
function posCard(e){const wr=mapWrap.getBoundingClientRect();let x=e.clientX-wr.left+16,y=e.clientY-wr.top-30;if(x+270>wr.width-8)x=e.clientX-wr.left-274;if(y<4)y=4;if(y+380>wr.height-4)y=wr.height-384;hcard.style.left=x+"px";hcard.style.top=y+"px"}
function showCard(e,info){document.getElementById("hc-flag").textContent=info.flag;document.getElementById("hc-name").textContent=info.name;document.getElementById("hc-region").textContent=info.region+" Africa";document.getElementById("hc-cap").textContent=info.cap;document.getElementById("hc-pop").textContent=info.pop;document.getElementById("hc-area").textContent=info.area;document.getElementById("hc-fact").textContent=info.fact;hcard.style.display="block";posCard(e)}
const zoom=d3.zoom().scaleExtent([0.8,8]).on("zoom",ev=>g.attr("transform",ev.transform));
svg.call(zoom);
document.getElementById("zin").onclick=()=>svg.transition().duration(300).call(zoom.scaleBy,1.5);
document.getElementById("zout").onclick=()=>svg.transition().duration(300).call(zoom.scaleBy,0.67);
document.getElementById("zreset").onclick=()=>svg.transition().duration(400).call(zoom.transform,d3.zoomIdentity);
d3.json("/countries-110m.json").then(world=>{
  const all=topojson.feature(world,world.objects.countries);
  const africa=all.features.filter(f=>CD[String(parseInt(f.id))]);
  g.selectAll("path.cp").data(africa).join("path").attr("class","cp").attr("d",pathGen).attr("fill",d=>{const i=CD[String(parseInt(d.id))];return i?i.color:"#4a6a4a";})
  .on("mouseover",function(e,d){const i=CD[String(parseInt(d.id))];if(i){d3.select(this).attr("fill","#F5D080");showCard(e,i);}})
  .on("mousemove",function(e){posCard(e);})
  .on("mouseout",function(e,d){const i=CD[String(parseInt(d.id))];if(i)d3.select(this).attr("fill",i.color);hcard.style.display="none";})
  .on("click",function(e,d){const i=CD[String(parseInt(d.id))];if(i)window.location.href="/nations/"+i.name.toLowerCase().replace(/\s+/g,"-").replace(/[^a-z0-9-]/g,"");});
  africa.forEach(f=>{
    const info=CD[String(parseInt(f.id))];if(!info)return;
    const b=pathGen.bounds(f);const w=b[1][0]-b[0][0],h=b[1][1]-b[0][1];
    if(w<14||h<10)return;
    const c=pathGen.centroid(f);if(isNaN(c[0])||isNaN(c[1]))return;
    let name=info.name;
    if(w<22&&name.length>6)return;
    if(w<40&&name.length>10)name=name.split(" ").map(p=>p[0]+".").join("");
    const fs=Math.max(6.5,Math.min(w/(name.length*0.7),h/2.8,13));
    const tw=name.length*fs*0.63+10,th=fs+7;
    g.append("rect").attr("x",c[0]-tw/2).attr("y",c[1]-th/2).attr("width",tw).attr("height",th).attr("rx",2).attr("fill","#0a0a06").attr("opacity",0.85).attr("pointer-events","none");
    g.append("text").attr("x",c[0]).attr("y",c[1]).attr("text-anchor","middle").attr("dominant-baseline","middle").attr("font-family","Space Mono,monospace").attr("font-weight","700").attr("font-size",fs).attr("fill","#ffffff").attr("pointer-events","none").text(name);
  });
});
</script>
